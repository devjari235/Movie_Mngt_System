﻿
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Movie Management System</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    @{
        if (Request.QueryString["logout"] == "true")
        {
            Session.Clear();
            Session.Abandon();
            Response.Redirect(Url.Action("Create", "Login"));
        }
    }
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark">
        <div class="container">
            @Html.ActionLink("Movie Management System", "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Toggle navigation" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    @if (Session["Email"] != null)
                    {
                        if (Session["Email"].ToString() == "admin@gmail.com")
                        {
                            <li>@Html.ActionLink("Movie", "Create", "Movie", new { area = "" }, new { @class = "nav-link" })</li>
                            <li>@Html.ActionLink("Category", "Create", "Category", new { area = "" }, new { @class = "nav-link" })</li>
                            <li>@Html.ActionLink("Search", "Details", "Search", new { area = "" }, new { @class = "nav-link" })</li>
                            <li><a href="?logout=true" class="nav-link">Logout</a></li>
                        }
                        else
                        {
                            <li>@Html.ActionLink("Booking", "Create", "Booking", new { area = "" }, new { @class = "nav-link" })</li>
                            <li>@Html.ActionLink("Profile", "Edit", "User", new { area = "" }, new { @class = "nav-link" })</li>
                            <li>@Html.ActionLink("Search", "Details", "Search", new { area = "" }, new { @class = "nav-link" })</li>
                            <li><a href="?logout=true" class="nav-link">Logout</a></li>
                        }
                    }
                    else
                    {
                        <li>@Html.ActionLink("Login", "Create", "Login", new { area = "" }, new { @class = "nav-link" })</li>
                    }
                </ul>
            </div>
        </div>
    </nav>
    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - Movie Management System</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>